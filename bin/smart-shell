#!/usr/bin/env bash
# smart-shell - install, check and run the dock.
#
#   smart-shell install [full|core|<widget>...]   packages + setup (paru)
#   smart-shell doctor                            what each widget is missing
#   smart-shell hyprland                          add the exec-once / blur lines
#   smart-shell start | restart | stop | log
#
# Widgets with extra needs: brightness nightlight docker bluetooth events system.
# Everything else (workspaces, clock, music, weather, tray, network, caps lock)
# only needs the core packages.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
SHELL_DIR="$REPO/shell"
HYPR_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/smart-shell/config.json"

WIDGETS=(brightness nightlight docker bluetooth events system)

# packages per widget; core is always installed
declare -A PKGS=(
  [core]="quickshell inter-font papirus-icon-theme qt6-5compat networkmanager iputils curl"
  [brightness]="ddcutil"
  [nightlight]="hyprsunset"
  [docker]="docker lazydocker"
  [bluetooth]="bluez bluez-utils blueman python-bluetooth-battery"
  [events]="python"
  [system]="btop kitty"
)

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
miss() { printf '  \033[31m✗\033[0m %s\n' "$*"; }
note() { printf '  \033[33m!\033[0m %s\n' "$*"; }

need_paru() {
  command -v paru >/dev/null || { echo "paru not found - install it first (https://github.com/Morganamilo/paru)" >&2; exit 1; }
}

in_group() { id -nG "$USER" | tr ' ' '\n' | grep -qx "$1"; }

# --- install -----------------------------------------------------------------

setup_widget() {
  case "$1" in
    brightness)
      echo i2c-dev | sudo tee /etc/modules-load.d/i2c-dev.conf >/dev/null
      sudo modprobe i2c-dev
      getent group i2c >/dev/null && ! in_group i2c && sudo usermod -aG i2c "$USER" \
        && note "added $USER to the i2c group - log out and back in"
      ;;
    docker)
      sudo systemctl enable --now docker.service
      ! in_group docker && sudo usermod -aG docker "$USER" \
        && note "added $USER to the docker group - log out and back in"
      ;;
    bluetooth)
      sudo systemctl enable --now bluetooth.service
      ;;
    events)
      "$REPO/tools/install-services.sh"
      command -v thunderbird >/dev/null || note "events are read from Thunderbird's calendars - install it"
      note "Thunderbird: turn on 'Offline support' for each calendar listed in events.calendars"
      ;;
  esac
  return 0
}

cmd_install() {
  need_paru
  local targets=("$@")
  [ ${#targets[@]} -eq 0 ] && targets=(core)
  [ "${targets[0]}" = full ] && targets=(core "${WIDGETS[@]}")

  local pkgs=() t
  for t in "${targets[@]}"; do
    [ -n "${PKGS[$t]+x}" ] || { echo "unknown widget: $t (try: core full ${WIDGETS[*]})" >&2; exit 1; }
    read -ra add <<<"${PKGS[$t]}"
    pkgs+=("${add[@]}")
  done
  if [[ " ${targets[*]} " != *" core "* ]]; then
    read -ra core <<<"${PKGS[core]}"
    pkgs+=("${core[@]}")
  fi

  bold "installing: ${pkgs[*]}"
  paru -S --needed "${pkgs[@]}"
  for t in "${targets[@]}"; do setup_widget "$t"; done

  if [ ! -f "$CONFIG" ]; then
    mkdir -p "$(dirname "$CONFIG")"
    cp "$REPO/config/config.example.json" "$CONFIG"
    note "created $CONFIG from the example - edit it to taste"
  fi
  grep -q 'smart-shell' "$HYPR_CONF" 2>/dev/null || note "run 'smart-shell hyprland' to start the dock with Hyprland"
  bold "done - 'smart-shell doctor' shows what's left"
}

# --- doctor ------------------------------------------------------------------

check_pkgs() {
  local p missing=()
  for p in $1; do pacman -Q "$p" >/dev/null 2>&1 || missing+=("$p"); done
  if [ ${#missing[@]} -eq 0 ]; then ok "packages"; else miss "missing: ${missing[*]}"; fi
}

cmd_doctor() {
  bold "core"
  check_pkgs "${PKGS[core]}"
  if grep -q "qs -p .*smart-shell" "$HYPR_CONF" 2>/dev/null; then ok "started by Hyprland"; else miss "not in hyprland.conf (smart-shell hyprland)"; fi
  if grep -q "namespace = smart-shell" "$HYPR_CONF" 2>/dev/null; then ok "blur rule"; else miss "no blur rule (smart-shell hyprland)"; fi
  if [ -f "$CONFIG" ]; then ok "config $CONFIG"; else note "no config - using defaults"; fi

  bold "brightness"
  check_pkgs "${PKGS[brightness]}"
  if lsmod | grep -q '^i2c_dev'; then ok "i2c-dev loaded"; else miss "i2c-dev not loaded"; fi
  if ls /dev/i2c-* >/dev/null 2>&1 && [ -r "$(ls /dev/i2c-* | head -1)" ]; then ok "i2c access"; else miss "no access to /dev/i2c-*"; fi

  bold "nightlight"
  check_pkgs "${PKGS[nightlight]}"

  bold "docker"
  check_pkgs "${PKGS[docker]}"
  if systemctl is-active -q docker; then ok "service running"; else note "docker service not running"; fi
  if in_group docker; then ok "user in docker group"; else miss "user not in docker group"; fi

  bold "bluetooth"
  check_pkgs "${PKGS[bluetooth]}"
  if systemctl is-active -q bluetooth; then ok "service running"; else miss "bluetooth service not running"; fi

  bold "events"
  check_pkgs "${PKGS[events]}"
  if systemctl --user is-active -q smart-shell-events.timer; then ok "export timer"; else miss "export timer off (smart-shell install events)"; fi
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/smart-shell/events.json"
  if [ -f "$cache" ]; then ok "events.json ($(date -r "$cache" +%H:%M))"; else miss "no events.json yet"; fi

  bold "system"
  check_pkgs "${PKGS[system]}"
  if grep -qs Tccd1 /sys/class/hwmon/hwmon*/temp*_label; then ok "Tccd1 sensor"; else note "no Tccd1 (non-AMD?) - temperature hidden"; fi
}

# --- hyprland ----------------------------------------------------------------

cmd_hyprland() {
  [ -f "$HYPR_CONF" ] || { echo "no $HYPR_CONF" >&2; exit 1; }
  local add=""
  grep -q "qs -p .*smart-shell" "$HYPR_CONF" || add+="
exec-once = qs -p $SHELL_DIR
"
  grep -q "namespace = smart-shell" "$HYPR_CONF" || add+="
# smart-shell: blur behind the dock's glass and its popovers
layerrule {
    name = smart-shell-blur
    match:namespace = smart-shell
    blur = yes
    blur_popups = yes
    ignore_alpha = 0.2
}
"
  if [ -z "$add" ]; then ok "hyprland.conf already set up"; return; fi
  bold "appending to $HYPR_CONF:"
  printf '%s\n' "$add"
  read -rp "ok? [y/N] " yes
  [ "$yes" = y ] || { echo "nothing changed"; return; }
  printf '%s' "$add" >>"$HYPR_CONF"
  hyprctl reload >/dev/null && ok "reloaded"
  note "if waybar also starts in hyprland.conf, comment it out"
}

# --- run ---------------------------------------------------------------------

cmd_stop() { pkill -x qs 2>/dev/null || true; pkill -x quickshell 2>/dev/null || true; }
cmd_start() {
  if command -v hyprctl >/dev/null && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl dispatch exec "qs -p $SHELL_DIR" >/dev/null
  else
    setsid -f qs -p "$SHELL_DIR" >/dev/null 2>&1
  fi
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  doctor) cmd_doctor ;;
  hyprland) cmd_hyprland ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; sleep 0.5; cmd_start ;;
  log) exec qs log -p "$SHELL_DIR" ;;
  *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
