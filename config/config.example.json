{
  "locale": "pt-BR",
  "dock": [
    {"id": "workspaces", "widgets": ["workspaces", "capslock"]},
    {"id": "apps", "widgets": ["apps"]},
    {"id": "status", "tiles": true, "widgets": ["music", "tray", "bluetooth", "quick", "weather", "clock"]}
  ],
  "quick": ["volume", "brightness", "docker", "network", "system", "settings"],
  "commands": {
    "monitor": "kitty -e btop",
    "docker": "kitty -e lazydocker"
  },
  "music": {"ignore": ["whatsapp"]},
  "weather": {"city": "Cuiabá", "lat": -15.6, "lon": -56.1},
  "workspaces": {"style": "icons", "icons": {"1": "house", "2": "git-branch", "3": "code", "4": "globe", "5": "gamepad-2"}},
  "tray": {"hidden": ["blueman", "bluetooth", "fcitx"]},
  "holidays": ["br", "cba", "us"],
  "events": {
    "calendars": ["you@example.com", "Family"],
    "daysBack": 7,
    "daysAhead": 60,
    "remindMinutes": 10,
    "categories": {
      "calendars": { "you@work.example": "work" },
      "keywords": { "health": ["consulta", "médico", "dentista"] }
    }
  }
}
